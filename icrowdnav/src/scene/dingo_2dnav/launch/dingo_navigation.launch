<launch>
    <param name="use_sim_time" value="true" />

    <!-- Load Robot Description -->
    <arg name="model" default="$(find dingo_description)/urdf/dingo.urdf"/>
    <param name="robot_description" textfile="$(arg model)" />

    <!-- Run the map server -->
    <node name="map_server" pkg="map_server" type="map_server" args="$(find dingo_2dnav)/map/dingo_warehouse_navigation.yaml" />

    <!-- social force model -->
    <node name="sfm" pkg="sfm_ros" type="main.py" output="screen"/>

    <!--- Run AMCL -->   
    <include file="$(find amcl)/examples/amcl_diff.launch" />

    <param name="/amcl/initial_pose_x"  value="0.0"/>
    <param name="/amcl/initial_pose_y"  value="3.0"/>
    <param name="/amcl/initial_pose_a"  value="0"/>
    
    <!--- Run ASTAR --> 
    <node pkg="astar" type="astar" name="astar" output="screen">
        <param name="Euclidean" value="true"/>
        <param name="OccupyThresh" value="-1"/>
        <param name="InflateRadius" value="0.30"/>
        <param name="rate" value="10"/>
        <remap from="/initialpose" to="/isaacsim_pose"/>
    </node>

    <!-- Run TrackPersons Messages -->
    <node pkg="pedsim_transform" type="track_persons.py" name="trackpersons" output="screen"/>

    <!--- rviz -->
    <node type="rviz" name="rviz" pkg="rviz" args="-d $(find dingo_2dnav)/rviz/dingo_2dnav.rviz"/>
</launch> 
